{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "exemplo-redirects",
  "account_id": "<ACCOUNT_ID>",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  // Domínios antigos: tudo redireciona (301) para a raiz de https://exemplo.com.br/
  // Custom domains do Worker: a Cloudflare cria/gerencia o DNS (apex e www) de cada zona.
  "routes": [
    { "pattern": "dominio-antigo.com.br", "custom_domain": true },
    { "pattern": "www.dominio-antigo.com.br", "custom_domain": true },
    { "pattern": "dominio-antigo-2.com.br", "custom_domain": true },
    { "pattern": "www.dominio-antigo-2.com.br", "custom_domain": true }
  ]
}
